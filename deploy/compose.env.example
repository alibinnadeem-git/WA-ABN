# Internal deployment configuration. Do not distribute this file to customers.
# Usage: docker compose --env-file /secure/vendor-alpha/compose.env -p vendor-alpha -f deploy/vendor.compose.yml up -d
# Run an offline readiness test before pairing: docker compose --env-file /secure/vendor-alpha/compose.env -p vendor-alpha -f deploy/vendor.compose.yml run --rm app node dist/filter-preflight.js
# application.env must set DATA_DIR=/data (the named, persistent, vendor-only volume).
# This file is for Docker Compose substitution only, not application secrets.
VENDOR_ENV_FILE=/secure/vendor-alpha/application.env

# Use a vendor-private image name and tag. Do not give customers access to source/build metadata.
VENDOR_IMAGE=vendor-alpha-service:2026-10
