# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5

COMPANY_CONTEXT="STRATUM provides <your services>. Ideal customers: <industries, company size, regions, job titles>."
DEFAULT_PHONE_REGION=US

# --- WhatsApp security boundary ---
WA_GROUP_JID=
# Optional pairing number, digits only, with country code
# WA_PAIRING_NUMBER=14085550123

# REQUIRED. 32 random bytes. Generate with: openssl rand -base64 32
# Keep this OUTSIDE DATA_DIR. Losing/changing it makes encrypted WhatsApp auth state unreadable.
WA_AUTH_ENCRYPTION_KEY=

# Optional fail-closed sender allowlist. Comma-separated participant JIDs.
# Leave empty to trust membership in WA_GROUP_JID; set it for highest assurance.
WA_ALLOWED_SENDER_JIDS=

CONTEXT_WAIT_SECONDS=120
MAX_MESSAGES_PER_MINUTE=20
MAX_IMAGE_BYTES=8388608

# --- Google Sheets ---
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# Persistent volume. Contains encrypted WhatsApp auth state and security audit log.
DATA_DIR=./data
