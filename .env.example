# --- Claude (https://console.anthropic.com → API keys) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional: defaults to claude-opus-5-5
# CLAUDE_MODEL=claude-opus-5-5

# What STRATUM sells and who the ideal customer is. Used to score leads Hot/Warm/Cold
# and suggest a next step. The more specific, the better.
COMPANY_CONTEXT="STRATUM provides <your services>. Ideal customers: <industries, company size, regions, job titles>."

# Country to assume when a card's phone number has no country code (ISO code, e.g. AE, PK, US)
DEFAULT_PHONE_REGION=AE

# --- WhatsApp ---
# Leave empty on first run: the bot prints the id of any group it sees a message in.
WA_GROUP_JID=
# Optional: link by code instead of QR (bot's number, digits only, with country code)
# WA_PAIRING_NUMBER=14155550123

# REQUIRED. 32-byte key used to AES-256-GCM encrypt Baileys linked-device credentials at rest.
# Generate once and store in your secret manager. DO NOT rotate without re-linking or migrating auth state:
#   openssl rand -base64 32
WA_AUTH_ENCRYPTION_KEY=

# Restrict !event / !status / !help commands to these sender JIDs. Comma-separated.
# If left empty, anyone in the configured WhatsApp group may use commands.
# WA_COMMAND_ADMIN_JIDS=14155550123@s.whatsapp.net

# Privacy-safe default: normal group chatter is ignored by the AI.
# Card photos and shared contacts are still processed automatically.
# Typed leads must use: !lead Jane Doe, Acme Corp, +1...
PROCESS_ALL_TEXT_MESSAGES=false

# How long to wait for a teammate to add context before processing anyway
CONTEXT_WAIT_SECONDS=120

# Input safety limits
MAX_MEDIA_MB=8
MAX_TEXT_CHARS=4000
MAX_VCARD_CHARS=16000

# --- Google Sheets ---
# The id from the sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads
# Service-account key: prefer a secret-manager injected JSON/base64 value.
# A file path is also supported; if used, chmod 600 the file.
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# Where encrypted WhatsApp login + non-sensitive bot state are stored.
# Mount a private persistent volume here in production.
DATA_DIR=./data

# Logging: avoid debug/trace in production because dependencies can emit sensitive metadata.
LOG_LEVEL=warn
