# --- Claude (https://console.anthropic.com → API keys) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional: defaults to claude-opus-5-5
# CLAUDE_MODEL=claude-opus-5-5

# What STRATUM sells and who the ideal customer is. Used to score leads Hot/Warm/Cold
# and suggest a next step. The more specific, the better.
COMPANY_CONTEXT="STRATUM provides <your services>. Ideal customers: <industries, company size, regions, job titles>."

# Country to assume when a card's phone number has no country code (ISO code, e.g. AE, PK, US)
DEFAULT_PHONE_REGION=AE

# --- WhatsApp ---
# Leave empty on first run: the bot prints the id of any group it sees a message in.
WA_GROUP_JID=
# Optional: link by 8-digit code instead of QR (bot's number, digits only, with country code)
# WA_PAIRING_NUMBER=971500000000
# How long to wait for a teammate to add context before processing anyway
CONTEXT_WAIT_SECONDS=120

# --- Google Sheets ---
# The id from the sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads
# Service-account key: a file path, the raw JSON, or the JSON base64-encoded
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# Where WhatsApp login + bot state are stored (mount a persistent volume here in production)
DATA_DIR=./data
