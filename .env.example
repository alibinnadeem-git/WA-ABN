# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5

COMPANY_CONTEXT="STRATUM provides <your services>. Ideal customers: <industries, company size, regions, job titles>."
DEFAULT_PHONE_REGION=AE

# --- WhatsApp ---
# Required for normal operation. Only this group is processed.
WA_GROUP_JID=

# Generate a dedicated 32-byte key and store it in your deployment secret manager:
#   openssl rand -base64 32
# Never commit the real value. Changing it makes existing encrypted WhatsApp auth state unreadable.
WA_AUTH_ENCRYPTION_KEY=

# Optional: link by one-time pairing code instead of QR.
# WA_PAIRING_NUMBER=971500000000

# OFF by default. Temporarily set true only to discover a group's JID, then turn it off.
WA_ALLOW_GROUP_DISCOVERY=false

# OFF by default. Set true for ONE controlled run when migrating existing plaintext
# data/wa-auth files. Turn it back off immediately after successful migration.
WA_ALLOW_PLAINTEXT_AUTH_MIGRATION=false

# Reject image payloads larger than this number of bytes. Default: 10 MiB.
WA_MAX_MEDIA_BYTES=10485760

CONTEXT_WAIT_SECONDS=120

# --- Google Sheets ---
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads
# Prefer a secrets manager value (raw JSON or base64 JSON) in production.
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# Persistent private data directory. Must not be web-served.
DATA_DIR=./data

# Logging
LOG_LEVEL=warn
