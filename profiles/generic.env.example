# WA-ABN Platform — generic starter configuration

# --- Application identity ---
APP_ID=my-whatsapp-app
APP_NAME="My WhatsApp App"
APP_DESCRIPTION="WhatsApp workflow automation"
APP_CONTEXT="Describe the organization, workflow, users, goals, and decision context here."
BOT_DISPLAY_NAME="WA Assistant"
APP_PROFILE=generic
WA_SESSION_ID=default

# --- Feature modules ---
FEATURE_LEAD_CRM=false
FEATURE_AI_EXTRACTION=false
FEATURE_SCHEDULER=true
FEATURE_POLLS=true
FEATURE_CONTACTS=true
FEATURE_MESSAGE_HISTORY=false
FEATURE_RECEIPTS=true
FEATURE_SEARCH=true
FEATURE_DIGESTS=true
FEATURE_EXPORTS=true
FEATURE_PIPELINE=true
FEATURE_BACKUPS=true
FEATURE_RETRY_QUEUE=true
FEATURE_WEBHOOKS=false

# --- AI (only needed by AI-enabled modules) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
DEFAULT_PHONE_REGION=US

# --- WhatsApp trust boundary ---
# Comma-separated group JIDs. Leave empty initially to discover candidate group JIDs in logs.
WA_ALLOWED_GROUP_JIDS=
# Legacy/single-group compatibility:
WA_GROUP_JID=
# Optional pairing number, digits only, country code included
WA_PAIRING_NUMBER=
# Optional comma-separated sender JID allowlist. Empty = trust authorized group membership.
WA_ALLOWED_SENDER_JIDS=

# REQUIRED. 32 random bytes: openssl rand -base64 32
WA_AUTH_ENCRYPTION_KEY=

MAX_MESSAGES_PER_MINUTE=20
MAX_IMAGE_BYTES=8388608
CONTEXT_WAIT_SECONDS=120

# --- Privacy/history ---
HISTORY_MAX_TEXT_CHARS=2000
HISTORY_RETENTION_DAYS=30

# --- Optional CRM backend (required only when FEATURE_LEAD_CRM=true) ---
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Optional read-only Ops Dashboard ---
OPS_DASHBOARD_ENABLED=false
OPS_DASHBOARD_HOST=127.0.0.1
OPS_DASHBOARD_PORT=8787
# Minimum 32 characters when dashboard is enabled.
OPS_DASHBOARD_TOKEN=

# --- Optional safe outbound workflow integration (n8n etc.) ---
# Disabled unless FEATURE_WEBHOOKS=true.
OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_TOKEN=
# Strongly recommended: explicit comma-separated host allowlist.
WEBHOOK_ALLOWED_HOSTS=

# Persistent data root. Sessions are namespaced beneath this when WA_SESSION_ID != default.
DATA_DIR=./data
