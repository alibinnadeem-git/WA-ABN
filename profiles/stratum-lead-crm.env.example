# Example profile: STRATUM lead capture / CRM
APP_ID=stratum-leads
APP_NAME="STRATUM"
APP_DESCRIPTION="STRATUM business-development WhatsApp lead operations"
APP_CONTEXT="STRATUM Power provides premium power, electrical infrastructure, AI infrastructure, EPC&C, maintenance and special projects. Configure the current ideal customer profile and target sectors here."
BOT_DISPLAY_NAME="STRATUM Lead Assistant"
APP_PROFILE=lead-crm
WA_SESSION_ID=stratum-leads

FEATURE_LEAD_CRM=true
FEATURE_AI_EXTRACTION=true
FEATURE_SCHEDULER=true
FEATURE_POLLS=true
FEATURE_CONTACTS=true
FEATURE_MESSAGE_HISTORY=false
FEATURE_RECEIPTS=true
FEATURE_SEARCH=true
FEATURE_DIGESTS=true
# 0 disables automatic digests; e.g. 24 = daily
AUTO_DIGEST_EVERY_HOURS=0
FEATURE_EXPORTS=true
FEATURE_PIPELINE=true
FEATURE_BACKUPS=true
FEATURE_RETRY_QUEUE=true
FEATURE_WEBHOOKS=false

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
DEFAULT_PHONE_REGION=US

WA_ALLOWED_GROUP_JIDS=
WA_ALLOWED_SENDER_JIDS=
WA_PAIRING_NUMBER=
WA_AUTH_ENCRYPTION_KEY=
MAX_MESSAGES_PER_MINUTE=20
MAX_IMAGE_BYTES=8388608
CONTEXT_WAIT_SECONDS=120

GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads
GOOGLE_SERVICE_ACCOUNT_JSON=

OPS_DASHBOARD_ENABLED=true
OPS_DASHBOARD_HOST=127.0.0.1
OPS_DASHBOARD_PORT=8787
OPS_DASHBOARD_TOKEN=

OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_TOKEN=
WEBHOOK_ALLOWED_HOSTS=

DATA_DIR=./data
