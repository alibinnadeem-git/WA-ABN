# Podium CRM: WhatsApp-native lead intelligence and approved STRATUM CRM handoff.
# Standalone filtering: no Google Sheets service account and no second STRATUM CRM database.
# Separate application secret store and private volume required.
# Use dedicated Podium CRM test WhatsApp linked-device account and approved groups.
APP_ID=podium-crm
APP_NAME="Podium CRM"
APP_DESCRIPTION="Cross-industry lead intake, classification, review and verified STRATUM CRM transfer"
APP_CONTEXT="STRATUM Power designs and delivers premium electrical and power infrastructure, AI/data-center infrastructure, EPC&C, maintenance and special projects. Relevant opportunities include data centers, power plants, industrial and high-tech construction, manufacturing, hospitals, campuses, airports and energy infrastructure. Evaluate each lead based on verified company relevance, geographic coverage, stated needs and documented commercial opportunity; do not assume fit from an unverified name. Use High/Medium/Low confidence, cite enrichment sources, and make next steps concrete."
BOT_DISPLAY_NAME="Podium CRM Assistant"
APP_PROFILE=podium-crm
TENANT_ID=podium-crm
WA_SESSION_ID=primary

FEATURE_LEAD_CRM=false
# Enable only with an Anthropic API key; AI usage and web research may incur charges.
FEATURE_AI_EXTRACTION=false
FEATURE_SCHEDULER=true
FEATURE_POLLS=true
FEATURE_CONTACTS=true
FEATURE_MESSAGE_HISTORY=false
# WhatsApp JIDs allowed to review and dispatch leads; empty denies all in-chat approvals.
FILTER_REVIEWER_JIDS=
FEATURE_FILTER_CRM=true
FEATURE_RECEIPTS=true
FEATURE_SEARCH=true
FEATURE_DIGESTS=true
# 0 disables automatic digests; e.g. 24 = daily
AUTO_DIGEST_EVERY_HOURS=0
FEATURE_EXPORTS=false
FEATURE_PIPELINE=false
FEATURE_BACKUPS=true
FEATURE_RETRY_QUEUE=true
FEATURE_WEBHOOKS=false

# --- Advanced gateway / optional free modules ---
# All remain OFF unless this vendor explicitly enables them.
FEATURE_ADVANCED_API=true
FEATURE_CAMPAIGNS=false
FEATURE_GROUP_ADMIN=false
FEATURE_API_MEDIA=false
FEATURE_EVENT_STREAM=false
FEATURE_INBOUND_WORKFLOWS=false

# Localhost-only API with three distinct vendor-private tokens:
ADVANCED_API_HOST=127.0.0.1
ADVANCED_API_PORT=8790
ADVANCED_VIEW_TOKEN=
ADVANCED_OPERATOR_TOKEN=
ADVANCED_ADMIN_TOKEN=
# comma-separated, manually approved contact JIDs; group JIDs come from WA_ALLOWED_GROUP_JIDS
ADVANCED_APPROVED_RECIPIENT_JIDS=
ADVANCED_CAMPAIGN_MAX_RECIPIENTS=25
ADVANCED_CAMPAIGN_INTERVAL_SECONDS=20
ADVANCED_SEND_PER_MINUTE=6
ADVANCED_SEND_PER_DAY=100

# Not required when FEATURE_AI_EXTRACTION=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
DEFAULT_PHONE_REGION=US

WA_ALLOWED_GROUP_JIDS=
WA_ALLOWED_SENDER_JIDS=
WA_PAIRING_NUMBER=
WA_AUTH_ENCRYPTION_KEY=
MAX_MESSAGES_PER_MINUTE=20
MAX_IMAGE_BYTES=8388608
CONTEXT_WAIT_SECONDS=120

GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads
GOOGLE_SERVICE_ACCOUNT_JSON=

OPS_DASHBOARD_ENABLED=false
OPS_DASHBOARD_HOST=127.0.0.1
OPS_DASHBOARD_PORT=8787
OPS_DASHBOARD_TOKEN=

OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_TOKEN=
WEBHOOK_ALLOWED_HOSTS=

DATA_DIR=/data

# --- Podium CRM -> existing STRATUM CRM (Neon via authenticated Next.js API) ---
FILTER_STRATUM_CRM_ENDPOINT=https://stratum-electric-crm.vercel.app/api/integrations/filter-crm/leads
FILTER_STRATUM_CRM_ALLOWED_HOST=stratum-electric-crm.vercel.app
# Unique secret, >=32 characters, provision matching value privately in StratumCRM:
FILTER_STRATUM_CRM_SECRET=
# When false, an approved reviewer must explicitly call the dispatch endpoint.
# When true, an admin approval immediately tries signed delivery:
FILTER_STRATUM_AUTO_DISPATCH=false
# IMPORTANT: For Docker Compose use DATA_DIR=/data to persist auth/source state on vendor_private_state.
# For local development, adjust DATA_DIR to a writable local directory.
# This is a template only — do not commit populated credentials or private JIDs.
